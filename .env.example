# Copy this file to .env and fill in real values. Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Groq (groq.com, fast open-model inference) is the fallback provider --
# NOT xAI's Grok. A Groq key starts with "gsk_"; get one at console.groq.com.
GROQ_API_KEY=
# Optional overrides; defaults live in config.py. Only currently served model
# names work — retired names (e.g. gemini-1.5-flash) 404 at request time.
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
