# Copy this file to .env and fill in real values. Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROK_API_KEY=
# Optional overrides; defaults live in config.py. Only currently served model
# names work — retired names (e.g. gemini-1.5-flash) 404 at request time.
# GEMINI_MODEL=gemini-3.6-flash
# GROK_MODEL=grok-2-latest
